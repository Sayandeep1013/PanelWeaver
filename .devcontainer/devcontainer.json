{
  "name": "PanelWeaver",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "features": { "ghcr.io/devcontainers/features/sshd:1": {} },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Previews" } },
  "customizations": {
    "codespaces": { "openFiles": ["docs/BUILD_GUIDE.md"] },
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
